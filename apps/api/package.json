{
  "name": "@releaseops/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "db:generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://releaseops:releaseops@localhost:5432/releaseops}\" prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@releaseops/shared": "workspace:*",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
