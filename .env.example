# Copy to .env at the repo root for local development.
# Docker Compose sets these itself for the containerized stack.
# The password below is a local default, not a production secret.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=0.1.0

DATABASE_URL=postgresql://releaseops:releaseops@localhost:5432/releaseops
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173

# Vite reads this when the web app starts or is built.
VITE_API_URL=http://localhost:3001
